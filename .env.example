# AI Model Settings (Google GenAI with Fallback Keys & Auto-Retry)
GOOGLE_API_KEY_ONE=your_google_api_key_1
GOOGLE_API_KEY_TWO=your_google_api_key_2
GOOGLE_API_KEY_THREE=your_google_api_key_3
GOOGLE_MODEL=gemini-3.5-flash-lite
GOOGLE_SUMMARY_MODEL=gemini-3.5-flash-lite
GOOGLE_MAX_RETRIES=3

# Legacy / Fallback Ollama Settings
OLLAMA_API_KEY_ONE=your_ollama_api_key
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_SUMMARY_MODEL=gemma4:31b-cloud

# Transcripts and Embeddings
GOOGLE_API_KEY=your_google_gemini_api_key
SUPADATA_KEY_ONE=your_supadata_api_key

# Vector Database (Qdrant Cloud)
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=youtube_video_embeddings

# Chat Memory (Upstash Redis - Optional)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Fallback Web Search (Tavily - Optional)
TAVILY_API_KEY=your_tavily_api_key

# Backend URL for Frontend
BACKEND_API_URL=http://127.0.0.1:8000
